services:
  frontend:
    image: {{ frontend_image }}
    container_name: frontend
    restart: unless-stopped
    ports:
      - "{{ frontend_port }}:5173"
    depends_on:
      - backend
    networks:
      - app-net

  backend:
    image: {{ backend_image }}
    container_name: backend
    restart: unless-stopped
    ports:
      - "{{ backend_port }}:3001"
    environment:
      DB_HOST: mysql
      DB_USER: {{ mysql_user }}
      DB_PASSWORD: {{ mysql_password }}
      DB_NAME: {{ mysql_database }}
    depends_on:
      - mysql
    networks:
      - app-net

  mysql:
    image: {{ mysql_image }}
    container_name: mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password }}
      MYSQL_DATABASE: {{ mysql_database }}
      MYSQL_USER: {{ mysql_user }}
      MYSQL_PASSWORD: {{ mysql_password }}
    volumes:
      - {{ app_base_dir }}/mysql:/var/lib/mysql
    networks:
      - app-net

  phpmyadmin:
    image: {{ phpmyadmin_image }}
    container_name: phpmyadmin
    restart: unless-stopped
    ports:
      - "{{ phpmyadmin_port }}:80"
    environment:
      PMA_HOST: mysql
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password }}
    depends_on:
      - mysql
    networks:
      - app-net

networks:
  app-net:
    driver: bridge